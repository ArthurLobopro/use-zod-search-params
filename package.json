{
  "name": "@arthur-lobo/use-zod-search-params",
  "version": "1.2.0",
  "author": "Arthur Lobo <64273139+ArthurLobopro@users.noreply.github.com>",
  "license": "MIT",
  "description": "React Hook to easily manipulate typed URL Search Params with zod.",
  "keywords": [
    "zod",
    "react",
    "search params",
    "query"
  ],
  "scripts": {
    "build": "tsc --emitDeclarationOnly && node build.js",
    "build:check": "tsc --noEmit",
    "prepack": "tsc",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:types": "tsc -p tsconfig.test.json"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-router-dom": ">=7.0.0",
    "zod": ">=4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/react-router-dom": "^5.3.3",
    "@vitest/coverage-v8": "^5.1.2",
    "esbuild": "^0.17.0",
    "jsdom": "^31.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.13.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2",
    "zod": "^4.3.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts"
}
